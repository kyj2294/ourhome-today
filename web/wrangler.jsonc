// Cloudflare Workers(정적 자산) 배포 설정: `npm run build && npx wrangler deploy`
// Cloudflare Pages 대시보드로 배포할 때는 이 파일 없이 빌드 명령 `npm run build`, 출력 폴더 `dist`만 지정하면 됩니다.
{
  "name": "ourhome-today",
  "compatibility_date": "2025-01-01",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  }
}
