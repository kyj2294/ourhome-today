// Cloudflare Workers 배포 설정: `npm run deploy` (= 빌드 후 wrangler deploy)
// 빌드 결과 dist/index.html 한 파일을 Worker 안에 넣어 그대로 돌려준다.
{
  "name": "ourhome-today",
  "main": "worker/index.js",
  "compatibility_date": "2025-01-01",
  "workers_dev": true,
  "preview_urls": false,
  "rules": [{ "type": "Text", "globs": ["**/*.html"], "fallthrough": true }]
}
