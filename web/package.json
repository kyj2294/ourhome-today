  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "~5.6.3",
    "vite": "^6.0.0",
    "vite-plugin-singlefile": "^2.3.4",
    "vitest": "^2.1.8",
    "wrangler": "^4.166.0"
  }
}
